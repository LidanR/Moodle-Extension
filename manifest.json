{
  "manifest_version": 3,
  "name": "Moodle JCT Redesign",
  "description": "Improves the design and usability of moodle.jct.ac.il with modern styles and small layout tweaks.",
  "version": "3.0.0",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "assets/icon-removebg-preview.png",
    "32": "assets/icon-removebg-preview.png",
    "48": "assets/icon-removebg-preview.png",
    "128": "assets/icon-removebg-preview.png"
  },
  "action": {
    "default_title": "JCT Moodle Extension",
    "default_icon": {
      "16": "assets/icon-removebg-preview.png",
      "32": "assets/icon-removebg-preview.png",
      "48": "assets/icon-removebg-preview.png",
      "128": "assets/icon-removebg-preview.png"
    }
  },
  "host_permissions": [
    "https://moodle.jct.ac.il/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://moodle.jct.ac.il/*"
      ],
      "js": [
        "src/js/theme-init.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://moodle.jct.ac.il/*"
      ],
      "js": [
        "src/js/config.js",
        "src/js/utils.js",
        "src/js/storage.js",
        "src/js/theme.js",
        "src/js/courses.js",
        "src/js/schedule.js",
        "src/js/assignments.js",
        "src/js/modals/settings-modal.js",
        "src/js/modals/assignments-modal.js",
        "src/js/modals/calendar-modal.js",
        "src/js/modals/whats-new-modal.js",
        "src/js/main.js"
      ],
      "css": [
        "src/css/base.css",
        "src/css/navbar.css",
        "src/css/courses.css",
        "src/css/course-page.css",
        "src/css/schedule.css",
        "src/css/modals.css",
        "src/css/dark-mode.css"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/placeholder.svg"
      ],
      "matches": [
        "https://moodle.jct.ac.il/*"
      ]
    }
  ]
}